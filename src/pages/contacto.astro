---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = "Contacto y Cita | Homeopatía Bilbao";
const description =
	"Pide información o cita en la consulta de homeopatía en Bilbao por teléfono, WhatsApp o email.";
const baseUrl = "./"
	// import.meta.env.BASE_URL.endsWith("/")
	// ? import.meta.env.BASE_URL
	// : `${import.meta.env.BASE_URL}/`;

// wa.me exige el número en formato internacional, solo dígitos
// (sin "+", ceros iniciales, espacios, paréntesis ni guiones).
// site.phoneHref tiene el formato "+34658746672" (el mismo que usa el enlace tel:).
const whatsappNumber = site.phoneHref.replace(/\D/g, "");
const whatsappMessage =
	"Hola, me gustaría solicitar información o una cita en la consulta de homeopatía.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout title={title} description={description}>
	<section class="section panel">
		<p class="eyebrow">Contacto</p>
		<h1>Solicitar información o cita</h1>
		<p>
			Puedes llamarnos al <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a>
			o escribirnos por WhatsApp al mismo número. Si lo prefieres, también puedes
			escribir directamente a <a href={`mailto:${site.email}`}>{site.email}</a>.
			La atención se presta de forma exclusivamente telematica.
		</p>
	</section>

	<section class="section split">
		<article class="panel">
			<h2>Datos de contacto</h2>
			<figure class="media-figure small">
				<img src={`${baseUrl}images/doctora02.jpg`} alt="Espacio de consulta en Bilbao" loading="lazy" />
			</figure>
			<ul class="list-clean">
				<li>Teléfono: <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></li>
				<li>WhatsApp: <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a></li>
				<li>Email: <a href={`mailto:${site.email}`}>{site.email}</a></li>
				<li>{site.serviceMode}</li>
			</ul>
		</article>

		<article class="panel" id="whatsapp">
			<h2>Contacta por WhatsApp</h2>
			<p>
				Escríbenos por WhatsApp Business al <strong>{site.phoneDisplay}</strong> para
				pedir información o cita. Al pulsar el botón se abrirá una conversación con
				un mensaje inicial que podrás editar antes de enviarlo.
			</p>
			<p>
				<a
					class="button"
					href={whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Abrir chat de WhatsApp con ${site.phoneDisplay}`}
				>
					Escribir por WhatsApp
				</a>
			</p>
			<p class="meta">
				Si no tienes WhatsApp instalado, puedes llamarnos al
				<a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a> o escribir a
				<a href={`mailto:${site.email}`}>{site.email}</a>.
			</p>
			<p class="meta">
				Al contactar, confirmas que has leído el <a href={`${baseUrl}aviso-legal`}>aviso legal</a>,
				la <a href={`${baseUrl}privacidad`}>política de privacidad</a> y la
				<a href={`${baseUrl}cookies`}>política de cookies</a>.
			</p>
		</article>
	</section>
</BaseLayout>
