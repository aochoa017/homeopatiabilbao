---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const title = "Blog de Salud | Homeopatía Bilbao";
const description =
	"Articulos de orientación homeopática sobre dolencias frecuentes en consulta de Bilbao.";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const posts = (await getCollection("blog")).sort(
	(a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
);

const readingMinutes = (body: string) => {
	const words = body.trim().split(/\s+/).length;
	return Math.min(10, Math.max(2, Math.ceil(words / 180)));
};
---

<BaseLayout title={title} description={description}>
	<section class="section panel">
		<p class="eyebrow">Blog</p>
		<h1>Articulos de salud y enfoque homeopático</h1>
		<p>
			Lecturas orientativas sobre dolencias frecuentes para entender mejor la
			evaluación individual en consulta.
		</p>
	</section>

	<section class="section blog-list">
		{
			posts.map((post, index) => (
				<article class="panel card" style={`--i:${index}`}>
					<p class="eyebrow">{post.data.category}</p>
					<h2>{post.data.title}</h2>
					<p>{post.data.description}</p>
					<p class="meta">
						{post.data.publishDate} · {post.data.author} · {readingMinutes(post.body)} min
					</p>
					<a class="text-link" href={`${baseUrl}blog/${post.id}`}>
						Leer articulo
					</a>
				</article>
			))
		}
	</section>
</BaseLayout>
