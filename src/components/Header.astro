---
const links = [
	{ path: "", label: "Inicio" },
	{ path: "doctora", label: "Doctora" },
	{ path: "enfoque-homeopatico", label: "Enfoque" },
	{ path: "casos", label: "Casos" },
	{ path: "blog", label: "Blog" },
	{ path: "contacto", label: "Contacto" },
];

const pathname = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header">
	<div class="container nav-wrap">
		<a class="brand" href={baseUrl} aria-label="Ir a inicio">
			<span class="brand-mark">HB</span>
			<span>
				<strong>Homeopatía Bilbao</strong>
				<small>Dra. Mª Luz Ramos</small>
			</span>
		</a>

		<nav aria-label="Navegacion principal">
			<ul>
				{
					links.map((link) => {
						const href = `${baseUrl}${link.path}`;
						const normalizedPathname = pathname.endsWith("/") ? pathname : `${pathname}/`;
						const normalizedHref = href.endsWith("/") ? href : `${href}/`;

						return (
						<li>
							<a
								href={href}
								class:list={{ active: normalizedPathname === normalizedHref }}
							>
								{link.label}
							</a>
						</li>
						);
					})
				}
			</ul>
		</nav>

		<a class="button compact" href={`${baseUrl}contacto`}>Pedir cita</a>
	</div>
</header>
